<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>kronikol-capture</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol\Kronikol.csproj" />
    <!-- For cross-runtime end-to-end capture goldens (pure classifiers + the live-server adapters; the
         StackExchange.Redis / Npgsql NuGet deps are already cached, so the offline restore works). -->
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.Redis\Kronikol.Extensions.Redis.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.Npgsql\Kronikol.Extensions.Npgsql.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.MongoDB\Kronikol.Extensions.MongoDB.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.Elasticsearch\Kronikol.Extensions.Elasticsearch.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.MySqlConnector\Kronikol.Extensions.MySqlConnector.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.ClickHouse\Kronikol.Extensions.ClickHouse.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.S3\Kronikol.Extensions.S3.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.SQS\Kronikol.Extensions.SQS.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.SNS\Kronikol.Extensions.SNS.csproj" />
    <ProjectReference Include="..\..\..\Kronikol\src\Kronikol.Extensions.DynamoDB\Kronikol.Extensions.DynamoDB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClickHouse ADO client + AWS SDK S3/SQS/SNS/DynamoDB for the live-server/emulator capture cases (cached). -->
    <PackageReference Include="ClickHouse.Client" Version="7.14.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.23" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.2.28" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.2.30" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.18.1" />
  </ItemGroup>

</Project>
